# PW Global Sales Booking Portal Configuration

# Port
PORT=3000

# Support Email CC Recipient
PW_GLOBAL_SUPPORT_EMAIL=pwglobal_support@pw.live

# Live SMTP Configuration (Optional: in development, simulated delivery is used if left blank)
# Example for Gmail:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=admissions.global@pw.live
# SMTP_PASS=your-16-character-app-password
# SMTP_FROM="PW Global Admissions <admissions.global@pw.live>"

# Example for SendGrid:
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASS=SG.your_api_key_here
# SMTP_FROM="PW Global Admissions <noreply@pw.live>"
